# Environment variables — NEVER commit real values, only this template.
# Copy to .env.local and populate with actual secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET: found in Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Auth
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: minimum 32 random bytes — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-bytes
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Encryption (KMS)
KMS_KEY_ID=your-kms-key-id
KMS_REGION=us-east-1
# SUPABASE_VAULT_SECRET: base64url-encoded 32-byte key used as KMS master key.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SUPABASE_VAULT_SECRET=your-base64url-32-byte-master-key

# DPI profile + consent
# HMAC_SECRET: minimum 32 random bytes — MUST differ from NEXTAUTH_SECRET.
# Generate with: openssl rand -hex 32
HMAC_SECRET=your-hmac-secret-min-32-bytes
# CONSENT_VERSION: bump this string to force re-consent on next login.
CONSENT_VERSION=v1.0

# Payments (provider credentials — never commit)
RECURRENTE_API_KEY=your-recurrente-key
NEONET_API_KEY=your-neonet-key
VISANET_API_KEY=your-visanet-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Upstash Redis (BullMQ)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Worker (Fly.io)
WORKER_BASE_URL=https://your-fly-app.fly.dev
WORKER_SECRET_TOKEN=your-worker-secret

# Email (Resend)
RESEND_API_KEY=your-resend-key

# Observability
SENTRY_DSN=your-sentry-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=your-otel-endpoint

# Logging
LOG_LEVEL=info

# Admin MFA (S2-05)
# ADMIN_IP_ALLOWLIST: comma-separated IPv4 CIDRs or exact IPs allowed to access /admin/*.
# If empty, all IPs are allowed with a warning (local dev only — set in production).
# Example: ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.5
ADMIN_IP_ALLOWLIST=
# ADMIN_TOTP_ENCRYPTION_KEY: base64url-encoded 32-byte key for encrypting TOTP secrets.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ADMIN_TOTP_ENCRYPTION_KEY=your-base64url-32-byte-totp-key
# WEBAUTHN_RP_ID: the relying party ID (hostname). Defaults to parsing NEXTAUTH_URL.
# In production set explicitly, e.g. tramitesalchilazo.com
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME: human-readable relying party name shown in passkey dialogs.
WEBAUTHN_RP_NAME=Tramites al Chilazo Admin

# Feature flags
FEATURE_FLAG_RENAP=false
FEATURE_FLAG_MINEX=false
