# Environment variables — NEVER commit real values, only this template.
# Copy to .env.local and populate with actual secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET: found in Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Auth
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: minimum 32 random bytes — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-bytes
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Encryption (KMS)
KMS_KEY_ID=your-kms-key-id
KMS_REGION=us-east-1

# Payments (provider credentials — never commit)
RECURRENTE_API_KEY=your-recurrente-key
NEONET_API_KEY=your-neonet-key
VISANET_API_KEY=your-visanet-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Upstash Redis (BullMQ)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Worker (Fly.io)
WORKER_BASE_URL=https://your-fly-app.fly.dev
WORKER_SECRET_TOKEN=your-worker-secret

# Email (Resend)
RESEND_API_KEY=your-resend-key

# Observability
SENTRY_DSN=your-sentry-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=your-otel-endpoint

# Logging
LOG_LEVEL=info

# Feature flags
FEATURE_FLAG_RENAP=false
FEATURE_FLAG_MINEX=false
