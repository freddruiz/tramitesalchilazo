# Disable lifecycle scripts by default for security (no postinstall vulnerabilities).
# Packages requiring scripts must be explicitly whitelisted below.
ignore-scripts=true

# Whitelisted packages allowed to run postinstall scripts (evaluated per package).
# Only add if absolutely necessary and script source is trusted.
# Format: package-name="*" for all versions, or specific versions
# Examples:
# husky="*"
# simple-git-hooks="*"

# Use lockfile from pnpm for deterministic installs
frozen-lockfile=true

# Enable strict peer dependency validation
strict-peer-dependencies=false

# Require exact version matches (no fuzzy matching)
force-exact-versions=false
